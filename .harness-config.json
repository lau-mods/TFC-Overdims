    "server": {
      "directory": ".harness-state/runtime/server",
      "command": ["./run.sh", "--nogui"],
      "address": "127.0.0.1:25579",
      "world": "harness-world"
    },
    "clients": ["tfcoverdims-a"],
    "deploy": [],
    "logs": []
